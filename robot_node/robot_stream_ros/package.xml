<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_stream_ros</name>
  <version>0.1.0</version>
  <description>ROS 2 Humble robot-side gateway for robot_stream: WebRTC/WHEP video (GStreamer x264 + MediaMTX), per-session deadman safety, waypoints, and token-authenticated rosbridge guard.</description>
  <maintainer email="7088549+daoanhtung@users.noreply.github.com">Dao Anh Tung</maintainer>
  <license>BSD-3-Clause</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-gi</exec_depend>
  <exec_depend>python3-tornado</exec_depend>
  <exec_depend>rosbridge_server</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
